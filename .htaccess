ErrorDocument 404 /404.html

RewriteEngine On
# /index and /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?]
RewriteRule ^ / [R=301,L]
# Redirect old .html addresses to their clean form, e.g. /consulting.html -> /consulting
RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)\.html[\s?]
RewriteRule ^ /%1 [R=301,L,NE]
